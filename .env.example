ENABLE_AGY_BRIDGE=1
AGY_COMMAND=agy
AGY_TIMEOUT_SECONDS=90
AGY_SKIP_PERMISSIONS=1
ENABLE_CODEX_BRIDGE=1
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_SECONDS=120
ENABLE_LIVE_RESEARCH=1
ENABLE_GOOGLE_NEWS_RSS=1
RESEARCH_TIMEOUT_SECONDS=8
ENABLE_REAL_MEDIA=1
ENABLE_LOCAL_DIFFUSION=1
LOCAL_DIFFUSION_MODEL=assets/models/sd-turbo
LOCAL_LORA_ADAPTER=
LOCAL_LORA_WEIGHT=0.8
ENABLE_LOCAL_CONTROLNET=1
LOCAL_CONTROLNET_BASE=assets/models/sd15-base
LOCAL_CONTROLNET_LINEART=assets/models/controlnet/lineart
# Optional overrides; defaults point to assets/models/piper.
PIPER_PT_MODEL=assets/models/piper/pt_BR-faber-medium.onnx
PIPER_PT_CONFIG=assets/models/piper/pt_BR-faber-medium.onnx.json
PIPER_EN_MODEL=assets/models/piper/en_US-amy-medium.onnx
PIPER_EN_CONFIG=assets/models/piper/en_US-amy-medium.onnx.json

# Future provider settings. Keep actual keys in the environment, never in frontend files.
GEMINI_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
